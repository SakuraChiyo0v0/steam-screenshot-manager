{
  "name": "steam-screenshot-manager",
  "version": "0.1.0",
  "private": true,
  "description": "本地优先的 Steam 截图管理与 WebDAV 备份桌面应用",
  "author": "SakuraChiyo0v0",
  "license": "UNLICENSED",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "dev": "electron-vite dev",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "electron-vite build",
    "self-check": "pnpm run build && electron . --self-check",
    "package": "pnpm run build && electron-builder --win",
    "package:dir": "pnpm run build && electron-builder --win --dir",
    "dev:ui": "vite --config vite.ui.config.ts"
  },
  "devDependencies": {
    "@node-steam/vdf": "^2.2.0",
    "@phosphor-icons/react": "^2.1.10",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
